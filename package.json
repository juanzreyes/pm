{
  "name": "pm-pollito",
  "version": "1.6.0",
  "description": "PM, tu pollito project manager: widget flotante que vigila tus límites de Claude y te acompaña en tu día.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "prerelease": "node scripts/check-release.js && npm run test:all",
    "release": "electron-builder --win --publish always",
    "postdist": "node scripts/build-public.js",
    "public": "node scripts/build-public.js",
    "test": "node --test tests/*.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "test:ui": "node --test --test-concurrency=1 tests/ui/*.test.js",
    "test:all": "npm run typecheck && npm test && npm run test:ui",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "Juan Ramon Reyes Linares",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "electron-updater": "^6.8.9",
    "ical.js": "^2.2.1",
    "imapflow": "^2.0.7"
  },
  "build": {
    "appId": "com.pm.pollito",
    "productName": "PM Pollito",
    "copyright": "© 2026 Juan Ramon Reyes Linares",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "oauth.config.example.json",
      "oauth.config.json",
      "package.json",
      "build/icon.png",
      "mcp/**/*",
      "cli/**/*",
      "CHANGELOG.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PM Pollito",
      "runAfterFinish": true,
      "artifactName": "PM-Pollito-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "mcp/**/*",
      "cli/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "PM Pollito lee el nombre de la app y la ventana activas para medir tu tiempo por proyecto y avisarte de distracciones."
      }
    },
    "dmg": {
      "artifactName": "PM-Pollito-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "juanzreyes",
        "repo": "pm",
        "releaseType": "release"
      }
    ]
  }
}
